# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here  # string aleatorio para verificar webhook

# ─── OpenRouter API (para Gemini y otros modelos) ────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...         # clave de https://openrouter.ai
LLM_MODEL=google/gemini-2.0-flash-001  # modelo a usar — ver openrouter.ai/models

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://restaurant_user:strong_password@localhost:5432/restaurant_agent

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_password@localhost:6379

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PIN=123456          # PIN de 6 dígitos para acceder al dashboard
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# ─── OCR (opcional — si se usa Google Vision en lugar de tesseract.js) ────────
# GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ─── Storage (para imágenes del menú y comprobantes de pago) ─────────────────
# Opción A: Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Opción B: AWS S3 o compatible (MinIO, Backblaze B2, etc.)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=restaurant-agent-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ─── Configuración de colas BullMQ ────────────────────────────────────────────
QUEUE_CONCURRENCY=10
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=1000

# ─── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_PHONE_RPS=3    # max 3 mensajes/seg por número
